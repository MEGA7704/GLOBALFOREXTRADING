<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="description" content="Connexion sécurisée à GLOBAL FOREX TRADING — Forex Capture Analyzer Edition"/>
  <title>Connexion — GLOBAL FOREX TRADING</title>
  <link rel="stylesheet" href="/assets/login.css?v=2.9.0"/>
</head>
<body>
  <main class="auth-layout">
    <section class="auth-visual" aria-label="Présentation de GLOBAL FOREX TRADING">
      <div class="grid-glow" aria-hidden="true"></div>
      <div class="visual-content">
        <h1>GLOBAL FOREX TRADING</h1>
        <p class="visual-subtitle">Forex Capture Analyzer Edition</p>
        <p class="visual-description">une plateforme sécurisée d’analyse de captures Forex, conçue pour détecter les tendances, identifier les zones clés et faciliter la prise de décision grâce à des indicateurs visuels professionnels.</p>
      </div>
    </section>

    <section class="auth-panel">
      <div class="auth-card">
        <div class="auth-card__top">
          <h2>GLOBAL FOREX TRADING</h2>
          <p>Forex Capture Analyzer Edition</p>
        </div>

        <div class="auth-section-heading">
          <span>ESPACE SÉCURISÉ</span>
          <h3>Connexion</h3>
          <p>Accédez à votre espace personnel.</p>
        </div>

        <div id="authAlert" class="alert" role="alert" hidden></div>

        <form id="loginForm" autocomplete="on">
          <label for="loginEmail">Adresse e-mail</label>
          <input id="loginEmail" name="email" type="email" autocomplete="username" required maxlength="180" placeholder="votre@email.com"/>

          <label for="loginPassword">Mot de passe</label>
          <span class="password-field">
            <input id="loginPassword" name="password" type="password" autocomplete="current-password" required minlength="10" maxlength="128" placeholder="Votre mot de passe"/>
            <button type="button" data-toggle-password="loginPassword" aria-label="Afficher le mot de passe" title="Afficher le mot de passe">◉</button>
          </span>

          <div class="auth-actions">
            <button class="primary-btn" id="loginButton" type="submit"><span>Se connecter</span><i>→</i></button>
            <button class="secondary-btn" id="showRegisterButton" type="button"><span>S’inscrire</span><i>＋</i></button>
          </div>
        </form>

        <div class="forgot-access">
          <button class="forgot-link" id="showForgotPasswordButton" type="button">Mot de passe oublié&nbsp;?</button>
        </div>

        <div class="auth-meta"><span id="systemState">Vérification du système…</span><span>Cookie HttpOnly sécurisé</span></div>
      </div>
      <p class="copyright">© <span id="currentYear"></span> MEGA SERVICES SARL U · Côte d’Ivoire</p>
    </section>
  </main>

  <dialog id="registerDialog" class="register-dialog" aria-labelledby="registerDialogTitle">
    <div class="dialog-shell">
      <header class="dialog-head dialog-head--register-centered">
        <div class="dialog-title-wrap dialog-title-wrap--centered">
          <span class="dialog-kicker">ESPACE MEMBRE</span>
          <h2 id="registerDialogTitle">Créer votre compte</h2>
          <p>Accès complet offert pendant 7 jours avec le plan Free.</p>
        </div>
        <button class="dialog-close" id="closeRegisterDialog" type="button" aria-label="Fermer">×</button>
      </header>

      <div id="registerAlert" class="alert dialog-alert" role="alert" hidden></div>

      <form id="registerForm" autocomplete="off">
        <div class="register-grid">
          <label>Nom et prénoms
            <input id="registerName" name="name" type="text" autocomplete="name" required minlength="2" maxlength="100" placeholder="Votre nom complet"/>
          </label>
          <label>Contact
            <input id="registerContact" name="companyName" type="tel" autocomplete="tel" required minlength="2" maxlength="140" placeholder="Votre contact"/>
          </label>
          <label class="field-full">Adresse e-mail du membre
            <input id="registerEmail" name="memberRegistrationEmail" type="email" autocomplete="off" autocapitalize="none" spellcheck="false" data-lpignore="true" data-1p-ignore="true" required maxlength="180" placeholder="membre@email.com"/>
          </label>
          <label>Mot de passe
            <span class="password-field"><input id="registerPassword" name="password" type="password" autocomplete="new-password" required minlength="12" maxlength="128" placeholder="12 caractères minimum"/><button type="button" data-toggle-password="registerPassword" aria-label="Afficher le mot de passe">◉</button></span>
          </label>
          <label>Confirmer le mot de passe
            <span class="password-field"><input id="registerPasswordConfirm" name="passwordConfirm" type="password" autocomplete="new-password" required minlength="12" maxlength="128" placeholder="Répétez le mot de passe"/><button type="button" data-toggle-password="registerPasswordConfirm" aria-label="Afficher le mot de passe">◉</button></span>
          </label>
        </div>

        <div class="password-rule">
          <b>Exigences de sécurité</b>
          <span>12 caractères minimum, avec une majuscule, une minuscule, un chiffre et un caractère spécial.</span>
        </div>

        <footer class="dialog-actions">
          <button class="secondary-btn" id="cancelRegisterButton" type="button"><span>Annuler</span><i>×</i></button>
          <button class="primary-btn" id="registerButton" type="submit"><span>Créer mon compte</span><i>→</i></button>
        </footer>
      </form>
    </div>
  </dialog>

  <dialog id="forgotPasswordDialog" class="register-dialog forgot-dialog" aria-labelledby="forgotPasswordDialogTitle">
    <div class="dialog-shell">
      <header class="dialog-head dialog-head--centered">
        <div>
          <span class="dialog-kicker">ASSISTANCE COMPTE</span>
          <h2 id="forgotPasswordDialogTitle">Demande de réinitialisation</h2>
          <p>Transmettez une demande sécurisée au Super Admin.</p>
        </div>
        <button class="dialog-close" id="closeForgotPasswordDialog" type="button" aria-label="Fermer">×</button>
      </header>

      <div id="forgotPasswordAlert" class="alert dialog-alert" role="alert" hidden></div>

      <form id="forgotPasswordForm" autocomplete="off">
        <div class="forgot-form-grid">
          <label>Nom et prénoms
            <input id="forgotPasswordName" name="name" type="text" autocomplete="name" maxlength="100" placeholder="Votre nom complet"/>
          </label>
          <label>Adresse e-mail du compte
            <input id="forgotPasswordEmail" name="email" type="email" autocomplete="email" required maxlength="180" placeholder="votre@email.com"/>
          </label>
          <label>Précision complémentaire <small>(facultatif)</small>
            <textarea id="forgotPasswordMessage" name="message" maxlength="500" rows="4" placeholder="Ajoutez une précision utile pour le Super Admin."></textarea>
          </label>
        </div>

        <div class="request-info">Pour protéger les comptes, aucune information d’existence ou de mot de passe n’est affichée sur cette page.</div>

        <footer class="dialog-actions">
          <button class="secondary-btn" id="cancelForgotPasswordButton" type="button"><span>Annuler</span><i>×</i></button>
          <button class="primary-btn" id="forgotPasswordSubmitButton" type="submit"><span>Envoyer la demande</span><i>→</i></button>
        </footer>
      </form>
    </div>
  </dialog>

  <script src="/assets/login.js?v=2.9.0" defer></script>
</body>
</html>
