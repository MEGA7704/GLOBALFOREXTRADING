<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Abonnement expiré — GOBAL TRADING</title>
  <link rel="stylesheet" href="/assets/login.css?v=2.4.0"/>
  <style>
    .expired-actions{display:grid;gap:10px;margin-top:20px}.secondary-btn{width:100%;border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.06);color:#fff;border-radius:14px;padding:13px;font-weight:900;cursor:pointer}.plan-summary{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:16px 0}.plan-summary article{border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.04);border-radius:14px;padding:13px}.plan-summary b{display:block;font-size:19px;color:#f0c763}.plan-summary span{font-size:11px;color:#9aa9bc}.expired-note{color:#c9d4e2;line-height:1.55;font-size:13px}
  </style>
</head>
<body>
  <main class="auth-layout">
    <section class="auth-visual" aria-label="Abonnement">
      <div class="grid-glow"></div>
      <div class="visual-content">
        <div class="visual-badge">ABONNEMENT ARRIVÉ À ÉCHÉANCE</div>
        <h1>RENOUVELEZ VOTRE<br/><span>ACCÈS BUSINESS</span></h1>
        <p>Les données de votre entreprise restent conservées dans Cloudflare D1. Le renouvellement réactive l’accès complet à l’application.</p>
        <div class="plan-summary">
          <article><b>21 jours</b><span>Plan Free</span></article>
          <article><b>365 jours</b><span>Plan Business</span></article>
        </div>
      </div>
    </section>
    <section class="auth-panel">
      <div class="auth-card">
        <div class="auth-card__top">
          <div class="mini-logo">GT</div>
          <div><h2>Accès temporairement suspendu</h2><p id="planDetails">Chargement de votre abonnement…</p></div>
        </div>
        <p class="expired-note">Achetez le plan Business, puis contactez le Super Admin pour confirmer l’activation de votre abonnement de 365 jours.</p>
        <div class="expired-actions">
          <button class="primary-btn" id="buyBusiness" type="button"><span>Acheter mon plan Business</span><i>→</i></button>
          <button class="secondary-btn" id="logoutButton" type="button">Se déconnecter</button>
        </div>
      </div>
    </section>
  </main>
  <script>
    (()=>{
      const paymentUrl="https://pay.wave.com/m/M_ci_Enx-2JNAklk-/c/ci/?amount=365000";
      let csrfToken="";
      async function csrf(){const r=await fetch('/api/csrf',{credentials:'same-origin'});const d=await r.json();csrfToken=d.csrfToken||'';}
      async function load(){try{await csrf();const r=await fetch('/api/me',{credentials:'same-origin'});const d=await r.json();if(r.ok&&d.plan){document.getElementById('planDetails').textContent=`Plan ${d.plan.label} · expiration : ${new Intl.DateTimeFormat('fr-FR',{dateStyle:'long'}).format(new Date(d.plan.expiresAt))}`;}}catch{}}
      document.getElementById('buyBusiness').addEventListener('click',()=>window.open(paymentUrl,'_blank','noopener,noreferrer'));
      document.getElementById('logoutButton').addEventListener('click',async()=>{try{if(!csrfToken)await csrf();await fetch('/api/logout',{method:'POST',headers:{'Content-Type':'application/json','X-CSRF-Token':csrfToken},body:'{}',credentials:'same-origin'});}finally{location.replace('/login');}});
      load();
    })();
  </script>
</body>
</html>
